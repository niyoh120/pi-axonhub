{
  "name": "@pandada8/pi-axonhub",
  "version": "1.0.2",
  "description": "Pi extension for discovering AxonHub models",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/niyoh120/pi-axonhub"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "axonhub",
    "llm"
  ],
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@earendil-works/pi-ai": "file:../../badlogic/pi-mono/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../../badlogic/pi-mono/packages/coding-agent",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  }
}
